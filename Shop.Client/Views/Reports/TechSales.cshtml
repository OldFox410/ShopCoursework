@using Shop.Domain.Dto.Query
@model IEnumerable<TechSalesStatDto>

<h2>💻 Статистика продаж техники</h2>
<p style="color: #666; margin-bottom: 20px;">Агрегированные данные по количеству проданных единиц техники и выручке.</p>

@if (Model != null && Model.Any())
{
    var totalQuantity = Model.Sum(x => x.TotalSoldCount);
    var totalRevenue = Model.Sum(x => x.TotalRevenue);

    <div style="display: flex; gap: 20px; margin-bottom: 20px;">
        <div style="background: #eef2f3; padding: 15px 20px; border-radius: 6px; flex: 1;">
            <strong>Всего продано единиц:</strong> <span style="font-size: 1.2em; color: #2980b9;">@totalQuantity шт.</span>
        </div>
        <div style="background: #eef2f3; padding: 15px 20px; border-radius: 6px; flex: 1;">
            <strong>Общая выручка:</strong> <span style="font-size: 1.2em; color: #27ae60;">@totalRevenue.ToString("C")</span>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Наименование товара</th>
                <th>Артикул</th>
                <th>Продано (шт.)</th>
                <th>Выручка</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td><strong>@item.ProductName</strong></td>
                    <td><code>@item.Article</code></td>
                    <td>@item.TotalSoldCount</td>
                    <td>@item.TotalRevenue.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p style="color: #e74c3c;">Данные о продажах техники не найдены.</p>
}