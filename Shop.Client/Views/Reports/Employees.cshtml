@using Shop.Client.Models
@model EmployeesReportModel

<h2>Список сотрудников</h2>

<form method="get" style="margin-bottom: 15px;">
    <label for="HasChildren">Наличие детей:</label>
    <select name="HasChildren" id="HasChildren" onchange="this.form.submit()">
        <option value="">-- Все --</option>
        <option value="true" selected="@(Model.Filter.HasChildren)">С детьми</option>
        <option value="false" selected="@(!Model.Filter.HasChildren)">Без детей</option>
    </select>
</form>

<table class="data-table">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Должность</th>
            <th>Телефон</th>
            <th>Дата приема</th>
            <th>Есть дети</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model.Items)
        {
            <tr>
                <td><strong>@emp.LastName @emp.FirstName @emp.MiddleName</strong></td>
                <td>@emp.Position</td>
                <td>@(emp.Phone ?? "—")</td>
                <td>@emp.HireDate.ToShortDateString()</td>
                <td>@(emp.HasChildren ? "Да" : "Нет")</td>
            </tr>
        }
    </tbody>
</table>